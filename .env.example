PORT=4000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=verify-full
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d
COOKIE_NAME=mb_session
COOKIE_SAME_SITE=lax
COOKIE_SECURE=false
ADMIN_NAME=Master Barbers Admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-this-before-deploying

# Optional Cloudflare R2 media storage (recommended for uploaded gallery media)
R2_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com
R2_REGION=auto
R2_BUCKET=master-barbers-media
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PUBLIC_BASE_URL=https://media.example.com
MAX_UPLOAD_MB=80
